{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-player",
  "version": "0.1.0",
  "identifier": "nl.thatzokay.music-player",
  "build": {
    "beforeDevCommand": "yarn run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Player",
        "width": 1080,
        "height": 720,
        "visible": false
      },
      {
        "width": 400,
        "height": 200,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "url": "splashscreen.html",
        "label": "splashscreen"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
